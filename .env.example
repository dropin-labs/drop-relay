# ==============================================================================
# DROP-RELAY — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ── Identity & Network Context ────────────────────────────────────────────────
RELAY_DOMAIN=example.com
RELAY_HOSTNAME=mail.example.com
RELAY_PORT_HTTP=8080
RELAY_API_KEY=change_me_to_a_secure_random_hex_string

# ── Internal SMTP Submission (Port 587) ───────────────────────────────────────
SMTP_USER=relay_user
SMTP_PASS=change_me_to_a_secure_submission_password

# ── DKIM Cryptography ─────────────────────────────────────────────────────────
DKIM_SELECTOR=relay
DKIM_KEY_PATH=/etc/opendkim/keys/relay.private

# ── Inbound Webhook Bridge (Port 25) ──────────────────────────────────────────
# Leave blank to disable inbound webhook ingestion
INBOUND_WEBHOOK_URL=http://app:3000/api/mail/inbound
RELAY_INTEGRITY_SECRET=change_me_to_a_secure_hmac_secret

# ── Optional: Upstream Smart-Host Relay ───────────────────────────────────────
# When configured, outbound mail routes via upstream instead of direct MX
# UPSTREAM_SMART_HOST=smtp.sendgrid.net:587
# UPSTREAM_AUTH_USER=apikey
# UPSTREAM_AUTH_PASS=SG.example_key

# ── TLS Certificates ──────────────────────────────────────────────────────────
# If omitted or paths do not exist, ephemeral self-signed certs are auto-generated
# TLS_CERT_PATH=/etc/letsencrypt/live/mail.example.com/fullchain.pem
# TLS_KEY_PATH=/etc/letsencrypt/live/mail.example.com/privkey.pem
