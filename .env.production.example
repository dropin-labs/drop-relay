# ==============================================================================
# DROP-RELAY — PRODUCTION ENVIRONMENT CONFIGURATION (VPS 161.97.140.8)
# ==============================================================================
# Target Host: Contabo Cloud VPS 4 (161.97.140.8)
# Primary Domain: dropin.rw
# ==============================================================================

# ── 1. Core Identity & Network Context ─────────────────────────────────────────
RELAY_DOMAIN=dropin.rw
RELAY_HOSTNAME=mail.dropin.rw
RELAY_PORT_HTTP=8080
PORT_MX=25
PORT_SUBMISSION=587
PORT_HTTP=8080

# ── 2. Ingestion API Authentication (Bearer Token) ────────────────────────────
# Must be a secure 32+ character random hex string
RELAY_API_KEY=replace_with_secure_production_token

# ── 3. Internal SMTP Submission (Port 587) ────────────────────────────────────
SMTP_USER=dropin_mailer
SMTP_PASS=replace_with_production_sasl_password

# ── 4. OpenDKIM Cryptography ──────────────────────────────────────────────────
# Must match existing DNS TXT record at dropin._domainkey.dropin.rw
DKIM_SELECTOR=dropin
DKIM_KEYS_DIR=/home/iradukunda/Lost/Projects/DropIn/dropin-mvp/infra/keys/prod/dkim

# ── 5. Inbound Webhook Bridge (Port 25 Pipe) ───────────────────────────────────
# Internal webhook endpoint on dropin-api container
INBOUND_WEBHOOK_URL=http://dropin-api:3000/api/internal/mail/inbound
# Must match INTEGRITY_SECRET in dropin-api
RELAY_INTEGRITY_SECRET=replace_with_matching_integrity_secret

# ── 6. Durability & Disk Spool ────────────────────────────────────────────────
BUFFER_TYPE=disk
SPOOL_DIR=/var/spool/drop-relay

# ── 7. Optional Upstream Smart-Host Relay (Fallback) ──────────────────────────
# UPSTREAM_SMART_HOST=
# UPSTREAM_AUTH_USER=
# UPSTREAM_AUTH_PASS=

# ── 8. TLS Certificates (Production Let's Encrypt) ────────────────────────────
TLS_CERT_PATH=/etc/letsencrypt/live/dropin.rw/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/dropin.rw/privkey.pem
